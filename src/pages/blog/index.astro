---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readingTime } from '../../lib/readingTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();

const blogListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "Mark's PC Parts — Blog",
  url: 'https://markspcparts.com/blog',
  itemListElement: posts.slice(0, 10).map((post, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://markspcparts.com/blog/${post.slug}`,
    name: post.data.title,
  })),
};
---

<Layout title="Blog" description="Hardware writeups, debug logs, and build notes from Mark's PC Parts.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogListLd)} />
  </Fragment>
  <Nav slot="nav" />

  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <p class="text-xs font-mono text-accent-light uppercase tracking-widest mb-6">Blog</p>
    <h1 class="text-3xl font-semibold text-slate-100 mb-2">Build logs &amp; debug notes</h1>
    <p class="text-steel text-base mb-10">Hardware writeups. What broke, what worked, what I'm running next.</p>

    {/* Tags */}
    <div class="flex flex-wrap gap-2 mb-12">
      {allTags.map(tag => (
        <a
          href={`/blog/tag/${tag}/`}
          class="text-xs font-mono px-3 py-1 rounded border transition-colors border-white/10 bg-surface-700 text-steel hover:border-accent-light hover:text-accent-light"
        >
          {tag}
        </a>
      ))}
    </div>

    {posts.length === 0 ? (
      <p class="text-steel">No posts yet.</p>
    ) : (
      <ul class="divide-y divide-white/5" id="post-list">
        {posts.map(post => {
          const dateStr = post.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'UTC',
          });
          return (
            <li class="py-8 group">
              <div>
                <a href={`/blog/${post.slug}/`} class="block">
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-6">
                    <div class="flex items-center gap-2 shrink-0 mb-2 sm:mb-0">
                      <time class="text-xs font-mono text-steel">{dateStr}</time>
                      {post.data.updatedDate && (
                        <>
                          <span class="text-white/15 text-xs">·</span>
                          <span class="text-xs font-mono text-accent-light">
                            Updated {post.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}
                          </span>
                        </>
                      )}
                      <span class="text-white/15 text-xs hidden sm:inline">·</span>
                      <span class="text-xs font-mono text-steel hidden sm:inline">{readingTime(post.body)}</span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h2 class="text-lg font-medium text-slate-100 group-hover:text-accent-light transition-colors mb-1">
                        {post.data.title}
                      </h2>
                      {post.data.description && (
                        <p class="text-steel text-sm leading-relaxed">{post.data.description}</p>
                      )}
                    </div>
                    <span class="hidden sm:inline-block shrink-0 text-accent-light opacity-0 group-hover:opacity-100 transition-opacity text-sm">
                      →
                    </span>
                  </div>
                </a>
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {post.data.tags.map(tag => (
                      <a
                        href={`/blog/tag/${tag}/`}
                        class="text-xs font-mono px-2 py-0.5 rounded bg-surface-700 text-steel border border-white/5 hover:border-accent-light hover:text-accent-light transition-colors"
                      >
                        {tag}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    )}
  </section>

  <Footer slot="footer" />
</Layout>
