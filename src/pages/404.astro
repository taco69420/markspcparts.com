---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Page Not Found"
  description="That page doesn't exist. Head back to Mark's PC Parts to browse rare and enthusiast hardware."
  canonicalUrl="https://markspcparts.com/404"
>
  <Nav slot="nav" />

  <section class="relative overflow-hidden">
    <!-- Grid background -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.03)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true"></div>
    <!-- Radial glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_-20%,rgba(124,58,237,0.15),transparent)]" aria-hidden="true"></div>

    <div class="relative max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-28 sm:py-36 text-center">
      <p class="text-xs font-mono text-accent-light uppercase tracking-widest mb-4">Error 404</p>
      <h1 class="text-4xl sm:text-5xl font-bold mb-6">
        <span class="font-mono text-accent-light">404</span> — dead socket
      </h1>
      <p class="text-steel leading-relaxed max-w-md mx-auto mb-10">
        This page didn't post. Either the link is bad or the part got pulled. Let's get you back
        to something that actually works.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-colors shadow-lg shadow-accent/25"
        >
          Back home
        </a>
        <a
          href="/inventory"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 text-steel font-medium text-sm hover:text-slate-100 hover:border-white/20 transition-colors"
        >
          Browse inventory
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 text-steel font-medium text-sm hover:text-slate-100 hover:border-white/20 transition-colors"
        >
          Read the blog
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
