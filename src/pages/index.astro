---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FindCard from '../components/FindCard.astro';
import { readingTime } from '../lib/readingTime';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const recentFinds = (await getCollection('finds'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const hallOfFame = (await getCollection('finds'))
  .filter(f => f.data.hallOfFame)
  .sort((a, b) => (a.data.rank ?? 999) - (b.data.rank ?? 999))
  .slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: "Mark's PC Parts",
  url: 'https://markspcparts.com',
  description: 'Rare, collectible, and enthusiast PC hardware sourced, tested, and documented by Mark in Redlands, CA.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://markspcparts.com/search?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
};

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mark',
  url: 'https://markspcparts.com',
  description: 'Rare and enthusiast PC hardware collector based in Redlands, CA.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Redlands',
    addressRegion: 'CA',
    addressCountry: 'US',
  },
  sameAs: [
    'https://www.tiktok.com/@tacoismybigboydaddy',
  ],
};
---

<Layout
  title="Rare &amp; Enthusiast PC Hardware"
  description="Rare, collectible, and enthusiast PC hardware sourced, tested, and documented. Redlands, CA."
  canonicalUrl="https://markspcparts.com/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </Fragment>
  <Nav slot="nav" />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-surface-900">
    <!-- Grid background -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(124,58,237,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(124,58,237,0.03)_1px,transparent_1px)] bg-[size:48px_48px]" aria-hidden="true"></div>
    <!-- Radial glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_50%_-20%,rgba(124,58,237,0.15),transparent)]" aria-hidden="true"></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-28 sm:py-36 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent/10 border border-accent/20 text-xs font-mono text-accent-light mb-8">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-light animate-pulse"></span>
        Redlands, CA · Rare &amp; Enthusiast Hardware
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
        Hardware too rare<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-light to-violet-300">
          to leave in a landfill
        </span>
      </h1>

      <p class="mt-6 max-w-xl mx-auto text-lg text-steel leading-relaxed">
        Collectible CPUs, legendary GPUs, and enthusiast boards — every piece I come across gets
        sourced, tested, and documented. This is where I keep the record.
      </p>

      <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/finds"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-semibold text-sm hover:bg-accent/90 transition-colors shadow-lg shadow-accent/25"
        >
          Browse Marks Finds
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-white/10 text-steel hover:text-slate-100 hover:border-white/20 font-medium text-sm transition-colors"
        >
          Read the Blog
        </a>
      </div>
    </div>
  </section>

  <!-- Marks Finds -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-xs font-mono text-accent-light uppercase tracking-widest mb-2">Marks Finds</p>
        <h2 class="text-2xl sm:text-3xl font-bold">Recently Documented</h2>
      </div>
      <a href="/finds" class="text-sm text-steel hover:text-accent-light transition-colors font-medium hidden sm:block">
        View all →
      </a>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recentFinds.map(find => (
        <FindCard
          title={find.data.title}
          category={find.data.category}
          description={find.data.description}
          image={find.data.images[0]?.src}
          href={`/finds/${find.slug}`}
          featured={find.data.hallOfFame}
        />
      ))}
    </div>

    <div class="mt-8 text-center sm:hidden">
      <a href="/finds" class="text-sm text-steel hover:text-accent-light transition-colors font-medium">
        View all finds →
      </a>
    </div>
  </section>

  <!-- Hall of Fame teaser -->
  {hallOfFame.length > 0 && (
    <section class="border-t border-white/5 bg-surface-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="flex items-end justify-between mb-10">
          <div>
            <p class="text-xs font-mono text-accent-light uppercase tracking-widest mb-2">Curated</p>
            <h2 class="text-2xl sm:text-3xl font-bold">Hall of Fame</h2>
          </div>
          <a href="/hall-of-fame" class="text-sm text-steel hover:text-accent-light transition-colors font-medium hidden sm:block">
            View all →
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-3">
          {hallOfFame.map(find => (
            <a href={`/finds/${find.slug}`} class="group block rounded-xl overflow-hidden border border-white/10 bg-surface-900 hover:border-accent/40 transition-colors">
              {find.data.images[0] && (
                <div class="aspect-[4/3] overflow-hidden">
                  <img src={find.data.images[0].src} alt={find.data.images[0].alt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
              )}
              <div class="p-4">
                <span class="text-xs font-mono text-accent-light uppercase tracking-widest">{find.data.category}</span>
                <h3 class="text-base font-semibold text-slate-100 mt-1 group-hover:text-accent-light transition-colors">{find.data.title}</h3>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 text-center sm:hidden">
          <a href="/hall-of-fame" class="text-sm text-steel hover:text-accent-light transition-colors font-medium">
            View the Hall of Fame →
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- Recent posts -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-xs font-mono text-accent-light uppercase tracking-widest mb-2">Blog</p>
        <h2 class="text-2xl sm:text-3xl font-bold">Recent Posts</h2>
      </div>
      <a href="/blog" class="text-sm text-steel hover:text-accent-light transition-colors font-medium hidden sm:block">
        View all →
      </a>
    </div>

    <ul class="divide-y divide-white/5">
      {recentPosts.map(post => {
        const dateStr = post.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
          timeZone: 'UTC',
        });
        return (
          <li class="py-8 group">
            <a href={`/blog/${post.slug}`} class="block">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-6">
                  <div class="flex items-center gap-2 shrink-0 mb-2 sm:mb-0">
                    <time class="text-xs font-mono text-steel">{dateStr}</time>
                    <span class="text-white/15 text-xs hidden sm:inline">·</span>
                    <span class="text-xs font-mono text-steel hidden sm:inline">{readingTime(post.body)}</span>
                  </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-lg font-medium text-slate-100 group-hover:text-accent-light transition-colors mb-1">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="text-steel text-sm leading-relaxed mb-3">{post.data.description}</p>
                  )}
                  {post.data.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5">
                      {post.data.tags.map(tag => (
                        <span class="text-xs font-mono px-2 py-0.5 rounded bg-surface-700 text-steel border border-white/5">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>
                <span class="hidden sm:inline-block shrink-0 text-accent-light opacity-0 group-hover:opacity-100 transition-opacity text-sm">
                  →
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>

    <div class="mt-8 text-center sm:hidden">
      <a href="/blog" class="text-sm text-steel hover:text-accent-light transition-colors font-medium">
        View all posts →
      </a>
    </div>
  </section>

  <!-- About blurb -->
  <section class="border-t border-white/5 bg-surface-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="max-w-2xl mx-auto text-center">
        <p class="text-xs font-mono text-accent-light uppercase tracking-widest mb-4">About Mark</p>
        <h2 class="text-2xl sm:text-3xl font-bold mb-5">Collector. Tinkerer. Documenter.</h2>
        <p class="text-steel leading-relaxed">
          Based in Redlands, CA — I source rare and enthusiast PC hardware and document it properly:
          full specs, condition notes, and the backstory behind how it ended up on my bench.
          Follow the builds and finds on TikTok.
        </p>
        <a href="/about" class="inline-block mt-6 text-sm text-accent-light hover:text-white transition-colors font-medium">
          Read more about me →
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
